<?xml version="1.0" encoding="UTF-8"?>
<project name="Minecraft_Mod" default="build" basedir=".">
    <description description="Builds, tests, and runs the project Minecraft_Mod."/>

    <property name="src-dir" location="src/"/>
    <property name="dist-dir" location="target"/>
    <property name="classes-dir" location="${dist-dir}/classes"/>
    <property name="jars" location="libs/minecraft_server.jar"/>

    <target name="init">
        <mkdir dir="${dist-dir}"/>
        <mkdir dir="${classes-dir}"/>
    </target>

    <target name="compile" depends="init">
        <javac srcdir="${src-dir}" destdir="${classes-dir}"
               includeantruntime="false" source="8" target="8"
               encoding="UTF-8" classpath="${jars}"/>
    </target>

    <target name="build" depends="compile">
        <jar destfile="${dist-dir}/${ant.project.name}.jar" basedir="${classes-dir}">
            <fileset file="${src-dir}/version.txt"/>
            <manifest>
                <attribute name="Class-Path" value="minecraft_server.jar mysql-connector-java-bin.jar plugins/"/>
                <attribute name="Main-Class" value="Main"/>
            </manifest>
        </jar>
    </target>

    <target name="clean">
        <delete dir="${dist-dir}"/>
    </target>
</project>
